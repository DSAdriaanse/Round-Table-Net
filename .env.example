# Copy to /etc/round-table-net/env on the server (mode 600). Never commit the real file.
# Non-secret settings (WordPress URL and username, club name) are edited in the app under Settings.
# Secrets live only here.

# Where the app listens. Set by the installer; to change any of these re-run setup with the matching
# option (--port, --mode, --listen, --proxy-ip), because Nginx and the firewall have to follow.
#   RT_PORT        the port. Give each copy of the app on one server its own port.
#   RT_LISTEN      127.0.0.1 when Nginx runs on this server; the server's address when an external proxy connects.
#   RT_MODE        local (Nginx and TLS here) or proxy (an external reverse proxy handles TLS)
#   RT_PROXY_IPS   proxy mode: the proxy address or range let through the firewall
RT_PORT=8090
RT_LISTEN=127.0.0.1
RT_MODE=local
RT_PROXY_IPS=

# Time zone of the club. Session dates, times in WordPress posts and the report use it.
TZ=America/Phoenix

# Public URL of the app
APP_URL=https://net.example.org

# The club PIN that net control operators type to sign in. REQUIRED (sign-in answers 503 without it).
# Use something longer than 4 digits; the server limits attempts but a short PIN is still guessable.
NCO_PIN=

# WordPress application password (URL and username are in Settings). Optional.
WORDPRESS_APP_PASSWORD=
# publish | draft  (default publish)
#WORDPRESS_POST_STATUS=draft

# AI one-paragraph summary on the WordPress report (optional; without it the post has no summary paragraph)
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5

# Behind Nginx on the same host. Makes rate limits see the real client IP.
TRUST_PROXY_HEADER=X-Real-IP
# Public check-in and PIN sign-in requests allowed per minute per client IP (defaults 30 and 10)
#PUBLIC_RATE_LIMIT=30
#PIN_RATE_LIMIT=10
